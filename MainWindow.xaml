<Window x:Class="PersonalLearningAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trợ lý học tập cá nhân"
        Width="900"
        Height="720"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Trợ lý học tập cá nhân"
                           FontSize="25"
                           FontWeight="Bold" />
                <TextBlock Text="Ghi nhớ và tra cứu kiến thức ngay trên máy tính của bạn."
                           Margin="0,5,0,16"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RememberModeButton"
                            Content="Ghi nhớ"
                            Style="{StaticResource ModeButtonStyle}"
                            Click="RememberModeButton_Click" />
                    <Button x:Name="ReadModeButton"
                            Content="Đọc"
                            Style="{StaticResource ModeButtonStyle}"
                            Click="ReadModeButton_Click" />
                    <TextBlock x:Name="ModeDescription"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Nhập nội dung mới để lưu." />
                    <StackPanel x:Name="SearchResultCountPanel"
                                Margin="20,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Số kết quả:"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <ComboBox x:Name="SearchResultCountComboBox"
                                  Width="74"
                                  IsEditable="True"
                                  Text="5"
                                  SelectionChanged="SearchResultCountComboBox_SelectionChanged"
                                  LostKeyboardFocus="SearchResultCountComboBox_LostKeyboardFocus"
                                  KeyDown="SearchResultCountComboBox_KeyDown">
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="25" />
                            <ComboBoxItem Content="30" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button Style="{StaticResource RoundedButtonStyle}"
                        Margin="0,0,6,0"
                        Content="Dữ liệu"
                        Padding="12,8"
                        FontSize="12"
                        Background="White"
                        Foreground="#475467"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        Click="DataButton_Click" />
                <Button Style="{StaticResource RoundedButtonStyle}"
                        Margin="0,0,6,0"
                        Content="Sao lưu"
                        Padding="12,8"
                        FontSize="12"
                        Background="White"
                        Foreground="#475467"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        Click="BackupButton_Click" />
                <Button Style="{StaticResource RoundedButtonStyle}"
                        Margin="0,0,6,0"
                        Content="Khôi phục"
                        Padding="12,8"
                        FontSize="12"
                        Background="White"
                        Foreground="#475467"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        Click="RestoreButton_Click" />
                <Button x:Name="UndoDeleteButton"
                        Style="{StaticResource RoundedButtonStyle}"
                        Margin="0,0,6,0"
                        Content="Hoàn tác xóa"
                        Padding="12,8"
                        FontSize="12"
                        Background="#FFFAEB"
                        Foreground="#B54708"
                        BorderBrush="#FEDF89"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="UndoDeleteButton_Click" />
                <Button Style="{StaticResource RoundedButtonStyle}"
                        Content="Cài đặt"
                        Padding="12,8"
                        FontSize="12"
                        Background="White"
                        Foreground="#475467"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ChatSurface">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ChatHistory"
                                Grid.ColumnSpan="2"
                                Width="{Binding ActualWidth, ElementName=ChatSurface}" />
                    <Border Grid.ColumnSpan="2"
                            Width="1"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Background="#98A2B3"
                            IsHitTestVisible="False"
                            Panel.ZIndex="1" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,8"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton"
                        Grid.Column="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Padding="14,9"
                        Content="Xóa"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#B42318"
                        Background="#FEF3F2"
                        BorderBrush="#FECDCA"
                        Cursor="Hand"
                        IsEnabled="False"
                        Opacity="0.5"
                        ToolTip="Chọn một câu trả lời của trợ lý để xóa ghi nhớ tương ứng."
                        Click="DeleteButton_Click" />
                <Button x:Name="ColorButton"
                        Grid.Column="1"
                        Style="{StaticResource RoundedButtonStyle}"
                        Margin="8,0,0,0"
                        Padding="14,9"
                        Content="Tô màu"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#344054"
                        Background="#F2F4F7"
                        BorderBrush="#D0D5DD"
                        Cursor="Hand"
                        IsEnabled="False"
                        Opacity="0.5"
                        ToolTip="Chọn văn bản trong bong bóng chat để tô màu."
                        Click="ColorButton_Click" />
                <Grid x:Name="CategoryInputHost"
                      Grid.Column="2"
                      Width="142"
                      Margin="12,0,0,0"
                      Visibility="Collapsed">
                    <TextBox x:Name="CategoryInput"
                             Padding="4,8"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             ToolTip="Danh mục tùy chọn cho ghi nhớ"
                             TextChanged="CategoryInput_TextChanged" />
                    <TextBlock x:Name="CategoryHint"
                               Margin="4,8,0,0"
                               IsHitTestVisible="False"
                               Foreground="#98A2B3"
                               FontSize="12"
                               Text="Danh mục (tùy chọn)" />
                </Grid>
                <Grid x:Name="MessageInputHost" Grid.Column="3" Margin="12,0,0,0">
                    <TextBox x:Name="MessageInput"
                             MinHeight="38"
                             MaxHeight="130"
                             Padding="2,8"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="MessageInput_KeyDown"
                             TextChanged="MessageInput_TextChanged" />
                    <TextBlock x:Name="InputHint"
                               Margin="2,8,0,0"
                               IsHitTestVisible="False"
                               Foreground="#98A2B3"
                               FontSize="14"
                               Text="Nhập nội dung cần ghi nhớ..." />
                </Grid>
                <Button Grid.Column="4"
                        Style="{StaticResource RoundedButtonStyle}"
                        Margin="12,0,0,0"
                        Padding="18,9"
                        Content="Gửi"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click" />
                <Popup x:Name="ColorPalettePopup"
                       PlacementTarget="{Binding ElementName=ColorButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Padding="6"
                            Background="White"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            CornerRadius="6">
                        <UniformGrid Rows="3" Columns="3">
                            <Button Tag="#E53935" ToolTip="Đỏ" Background="#E53935" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#FB8C00" ToolTip="Cam" Background="#FB8C00" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#F9A825" ToolTip="Vàng" Background="#F9A825" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#43A047" ToolTip="Xanh lá cây" Background="#43A047" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#1B5E20" ToolTip="Xanh lá đậm" Background="#1B5E20" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#00ACC1" ToolTip="Xanh lơ" Background="#00ACC1" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#1E88E5" ToolTip="Xanh dương" Background="#1E88E5" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#1A237E" ToolTip="Xanh hải quân" Background="#1A237E" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                            <Button Tag="#8E24AA" ToolTip="Tím" Background="#8E24AA" Click="ColorSwatch_Click" Width="30" Height="30" Margin="3" BorderBrush="White" Style="{StaticResource RoundedButtonStyle}" />
                        </UniformGrid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="DataLocation"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
