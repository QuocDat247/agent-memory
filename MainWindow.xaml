<Window x:Class="PersonalLearningAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trợ lý học tập cá nhân"
        Width="900"
        Height="720"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Trợ lý học tập cá nhân"
                           FontSize="25"
                           FontWeight="Bold" />
                <TextBlock Text="Ghi nhớ và tra cứu kiến thức ngay trên máy tính của bạn."
                           Margin="0,5,0,16"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RememberModeButton"
                            Content="Ghi nhớ"
                            Style="{StaticResource ModeButtonStyle}"
                            Click="RememberModeButton_Click" />
                    <Button x:Name="ReadModeButton"
                            Content="Đọc"
                            Style="{StaticResource ModeButtonStyle}"
                            Click="ReadModeButton_Click" />
                    <TextBlock x:Name="ModeDescription"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Nhập nội dung mới để lưu." />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Cài đặt"
                    Padding="14,9"
                    VerticalAlignment="Top"
                    FontSize="13"
                    Background="White"
                    Foreground="#475467"
                    BorderBrush="#D0D5DD"
                    Cursor="Hand"
                    Click="SettingsButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <ScrollViewer x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChatHistory">
                    <Border x:Name="WelcomeBubble"
                            HorizontalAlignment="Left"
                            MaxWidth="680"
                            Margin="0,0,48,12"
                            Padding="14"
                            Background="#F2F4F7"
                            CornerRadius="10">
                        <TextBox Text="Xin chào! Chọn “Ghi nhớ” để lưu thông tin hoặc “Đọc” để tìm lại nội dung gần giống nhất trong dữ liệu đã lưu."
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 TextWrapping="Wrap"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Padding="0"
                                 Background="Transparent"
                                 Focusable="True"
                                 Cursor="IBeam"
                                 SelectionChanged="ChatMessage_SelectionChanged" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,8"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton"
                        Grid.Column="0"
                        Padding="14,9"
                        Content="Xóa"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#B42318"
                        Background="#FEF3F2"
                        BorderBrush="#FECDCA"
                        Cursor="Hand"
                        IsEnabled="False"
                        Opacity="0.5"
                        ToolTip="Chọn một câu trả lời của trợ lý để xóa ghi nhớ tương ứng."
                        Click="DeleteButton_Click" />
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <TextBox x:Name="MessageInput"
                             MinHeight="38"
                             MaxHeight="130"
                             Padding="2,8"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="MessageInput_KeyDown"
                             TextChanged="MessageInput_TextChanged" />
                    <TextBlock x:Name="InputHint"
                               Margin="2,8,0,0"
                               IsHitTestVisible="False"
                               Foreground="#98A2B3"
                               FontSize="14"
                               Text="Nhập nội dung cần ghi nhớ..." />
                </Grid>
                <Button Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="18,9"
                        Content="Gửi"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="DataLocation"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
